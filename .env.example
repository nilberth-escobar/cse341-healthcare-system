# Server configuration
PORT=3000

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/hospital_management

# JWT configuration
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
TOKEN_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d

# Session configuration
SESSION_SECRET=change-this-session-secret

# CORS configuration
ALLOWED_ORIGINS=http://localhost:3000

# GitHub OAuth configuration
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
# IMPORTANT: This must match the callback route registered with GitHub and the
# route defined in routes/authRoutes.js. The API expects the /api/auth/github/callback
# path, so keep the /api/auth prefix when running locally.
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback
